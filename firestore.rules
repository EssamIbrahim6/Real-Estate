rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(conversation) {
      return signedIn() &&
        conversation.participants is list &&
        request.auth.uid in conversation.participants;
    }

    function validConversationCreate() {
      let data = request.resource.data;
      let agentPath = /databases/$(database)/documents/agents/$(data.agentId);
      let estatePath = /databases/$(database)/documents/estates/$(data.estateId);
      return signedIn() &&
        data.keys().hasAll([
          'participants',
          'customerId',
          'agentUserId',
          'agentId',
          'estateId',
          'createdAt',
          'lastMessage',
          'lastMessageAt',
          'lastSenderId',
          'lastReadAtByParticipant'
        ]) &&
        data.keys().hasOnly([
          'participants',
          'customerId',
          'agentUserId',
          'agentId',
          'estateId',
          'createdAt',
          'lastMessage',
          'lastMessageAt',
          'lastSenderId',
          'lastReadAtByParticipant'
        ]) &&
        data.customerId is string &&
        data.customerId.size() > 0 &&
        data.agentUserId is string &&
        data.agentUserId.size() > 0 &&
        data.agentId is string &&
        data.agentId.size() > 0 &&
        data.estateId is string &&
        data.estateId.size() > 0 &&
        data.customerId != data.agentUserId &&
        data.participants is list &&
        data.participants.size() == 2 &&
        data.participants[0] == data.customerId &&
        data.participants[1] == data.agentUserId &&
        request.auth.uid == data.customerId &&
        data.createdAt == request.time &&
        data.lastMessage == null &&
        data.lastMessageAt == null &&
        data.lastSenderId == null &&
        data.lastReadAtByParticipant is map &&
        data.lastReadAtByParticipant.size() == 0 &&
        exists(agentPath) &&
        get(agentPath).data.userId == data.agentUserId &&
        exists(estatePath) &&
        get(estatePath).data.agentId == data.agentId;
    }

    function validReadTimestampUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldReadAt = resource.data.get('lastReadAtByParticipant', {});
      let newReadAt = request.resource.data.get(
        'lastReadAtByParticipant',
        {}
      );
      return changed.hasOnly(['lastReadAtByParticipant']) &&
        newReadAt is map &&
        newReadAt.diff(oldReadAt).affectedKeys().hasOnly([request.auth.uid]) &&
        newReadAt.get(request.auth.uid, null) == request.time;
    }

    function validMessageSummaryUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'lastMessage',
          'lastMessageAt',
          'lastSenderId'
        ]) &&
        changed.hasAll([
          'lastMessage',
          'lastMessageAt',
          'lastSenderId'
        ]) &&
        request.resource.data.lastMessage is string &&
        request.resource.data.lastMessage.size() > 0 &&
        request.resource.data.lastMessageAt == request.time &&
        request.resource.data.lastSenderId == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow create: if validConversationCreate();
      allow get: if isParticipant(resource.data);
      allow list: if signedIn() &&
        request.auth.uid in resource.data.participants;
      allow update: if isParticipant(resource.data) &&
        request.resource.data.customerId == resource.data.customerId &&
        request.resource.data.agentUserId == resource.data.agentUserId &&
        request.resource.data.agentId == resource.data.agentId &&
        request.resource.data.estateId == resource.data.estateId &&
        request.resource.data.participants == resource.data.participants &&
        (validReadTimestampUpdate() || validMessageSummaryUpdate());
      allow delete: if false;

      match /messages/{messageId} {
        function parentConversation() {
          return get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data;
        }

        allow read: if isParticipant(parentConversation());
        allow create: if isParticipant(parentConversation()) &&
          request.resource.data.keys().hasAll([
            'senderId',
            'text',
            'createdAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'senderId',
            'text',
            'createdAt'
          ]) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    function isAssignedAgent(agentId) {
      let agentPath = /databases/$(database)/documents/agents/$(agentId);
      return signedIn() && exists(agentPath) && get(agentPath).data.userId == request.auth.uid;
    }

    function validBookingCreate() {
      let data = request.resource.data;
      let estatePath = /databases/$(database)/documents/estates/$(data.estateId);
      let agentPath = /databases/$(database)/documents/agents/$(data.agentId);
      return signedIn() &&
        data.customerId == request.auth.uid &&
        data.status == 'pending' &&
        data.createdAt == request.time &&
        data.updatedAt == request.time &&
        data.bookingDate is timestamp &&
        data.bookingDate > request.time &&
        data.timeSlot is string && data.timeSlot.size() > 0 &&
        data.customerName is string && data.customerName.size() > 0 &&
        data.customerEmail is string && data.customerEmail.size() > 0 &&
        data.customerPhone is string && data.customerPhone.size() > 0 &&
        data.estateId is string && data.estateId.size() > 0 &&
        data.agentId is string && data.agentId.size() > 0 &&
        exists(estatePath) &&
        get(estatePath).data.get('isAvailable', true) == true &&
        get(estatePath).data.agentId == data.agentId &&
        exists(agentPath) &&
        (data.agentUserId == null || get(agentPath).data.userId == data.agentUserId);
    }

    function validBookingCustomerCancel() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.auth.uid == resource.data.customerId &&
        changed.hasOnly(['status', 'updatedAt']) &&
        resource.data.status in ['pending', 'confirmed'] &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.updatedAt == request.time;
    }

    function validBookingAgentUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let isAgent = isAssignedAgent(resource.data.agentId);
      let validTransition =
        (resource.data.status == 'pending' && request.resource.data.status in ['confirmed', 'cancelled']) ||
        (resource.data.status == 'confirmed' && request.resource.data.status in ['completed', 'cancelled']);
      return isAgent &&
        changed.hasOnly(['status', 'updatedAt']) &&
        validTransition &&
        request.resource.data.updatedAt == request.time;
    }

    match /bookings/{bookingId} {
      allow create: if validBookingCreate();
      allow get: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        isAssignedAgent(resource.data.agentId)
      );
      allow list: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        isAssignedAgent(resource.data.agentId)
      );
      allow update: if signedIn() && (
        validBookingCustomerCancel() ||
        validBookingAgentUpdate()
      );
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    function validNotificationCreate() {
      let data = request.resource.data;
      let isBase = signedIn() &&
        data.recipientId is string && data.recipientId.size() > 0 &&
        data.type is string && data.type.size() > 0 &&
        data.title is string && data.title.size() > 0 &&
        data.body is string &&
        data.isRead == false;

      let isSelf = isBase && data.recipientId == request.auth.uid;

      let isChatPeer = isBase &&
        data.type == 'chatMessage' &&
        data.entityType == 'conversation' &&
        data.entityId is string &&
        exists(/databases/$(database)/documents/conversations/$(data.entityId)) &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(data.entityId)).data.participants &&
        data.recipientId in get(/databases/$(database)/documents/conversations/$(data.entityId)).data.participants;

      let isBookingParty = isBase &&
        (data.type == 'bookingReceived' || data.type == 'bookingStatusChanged') &&
        data.entityType == 'booking' &&
        data.entityId is string &&
        exists(/databases/$(database)/documents/bookings/$(data.entityId)) &&
        (
          get(/databases/$(database)/documents/bookings/$(data.entityId)).data.customerId == request.auth.uid ||
          isAssignedAgent(get(/databases/$(database)/documents/bookings/$(data.entityId)).data.agentId)
        );

      return isSelf || isChatPeer || isBookingParty;
    }

    match /notifications/{notificationId} {
      allow get, list: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if validNotificationCreate();
      allow update: if signedIn() &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
        request.resource.data.isRead is bool;
      allow delete: if false;
    }
  }
}